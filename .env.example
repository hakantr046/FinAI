# Used by docker-compose.yml when running `docker compose up`
JWT_KEY=generate_a_random_32+_char_secret_here
EMAIL_SENDER=your_gmail_address@gmail.com
EMAIL_SENDER_PASSWORD=your_gmail_app_password_here
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Postgres credentials (defaults to postgres/postgres locally if unset —
# MUST be changed to something strong before deploying to a public VPS)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Public origins. Leave as-is for local `docker compose up`; on a VPS set
# these to your real domain (e.g. https://app.example.com /
# https://api.example.com) so CORS, the frontend's API calls, and password
# reset emails point at the right place.
NEXT_PUBLIC_API_URL=http://localhost:5115
FRONTEND_BASE_URL=http://localhost:3000
